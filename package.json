{
  "name": "pi-model-lock",
  "version": "1.0.0",
  "description": "pi extension: prevent /model from persisting the new model as the global default in settings.json",
  "keywords": [
    "pi-package",
    "pi-extension",
    "model",
    "settings"
  ],
  "license": "MIT",
  "author": "David Raistrick",
  "homepage": "https://github.com/keen99/pi-model-lock",
  "repository": {
    "type": "git",
    "url": "https://github.com/keen99/pi-model-lock.git"
  },
  "type": "module",
  "main": "./index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npx --yes tsx@4.20.6 --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "test:matrix": "node test/release-matrix.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.75.4",
    "typescript": "5.9.3"
  }
}